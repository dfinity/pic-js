type Time = int;
type PublicKeyResult = variant { ok : nat; err : text };

service : {
  get_time : () -> (Time) query;
  set_certified_data : (blob) -> ();
  get_certificate : () -> (opt blob) query;
  print_log : (text) -> ();
  ecdsa_public_key_size : (text) -> (PublicKeyResult);
  schnorr_public_key_size : (text) -> (PublicKeyResult);
  vetkd_public_key_size : (text) -> (PublicKeyResult);
  whoami : () -> (principal) query;
  set_value : (nat) -> ();
  get_value : () -> (nat) query;
  noop : () -> ();
  increment_value_after_call : () -> (nat);
}
