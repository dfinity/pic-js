type WithdrawResult = variant {
  ok;
  err : variant { InsufficientFunds; TransferFailed };
};

service : {
  deposit : (nat) -> ();
  balance : () -> (nat) query;
  paid_out : () -> (nat) query;
  withdraw_vulnerable : (nat) -> (WithdrawResult);
  withdraw_fixed : (nat) -> (WithdrawResult);
  transfer : (principal, nat) -> ();
}
